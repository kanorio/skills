{
  "schema": "kanorio-style-tokens/1",
  "defaultTheme": "light",
  "color": {
    "light": {
      "background": "oklch(100% 0 0)",
      "surface": "oklch(97.6% 0 0)",
      "text": "oklch(18% 0 0)",
      "textMuted": "oklch(48% 0 0)",
      "border": "oklch(89% 0 0)",
      "accent": "oklch(72% 0.2 130)",
      "accentText": "oklch(14% 0 0)"
    },
    "dark": {
      "background": "oklch(0% 0 0)",
      "surface": "oklch(21.8% 0 0)",
      "text": "oklch(97% 0 0)",
      "textMuted": "oklch(76% 0 0)",
      "border": "oklch(33% 0 0)",
      "accent": "oklch(72% 0.2 130)",
      "accentText": "oklch(14% 0 0)"
    }
  },
  "font": {
    "display": {
      "family": "Encode Sans",
      "category": "sans",
      "weights": [700, 800],
      "license": "OFL-1.1"
    },
    "body": {
      "family": "Encode Sans",
      "category": "sans",
      "weights": [400, 700],
      "license": "OFL-1.1"
    }
  },
  "typeScale": {
    "display": "clamp(2.25rem, 1.4rem + 2.8vw, 3.5rem)",
    "h1": "clamp(2rem, 1.45rem + 1.9vw, 3rem)",
    "h2": "clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem)",
    "h3": "1.25rem",
    "body": "1rem",
    "small": "0.875rem"
  },
  "space": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "40px", "48px", "64px", "75px", "96px"],
  "radius": {
    "control": "2px",
    "card": "12px",
    "media": "12px"
  },
  "shadow": {
    "card": "0 1px 2px oklch(0% 0 0 / 0.08), 0 2px 6px oklch(0% 0 0 / 0.12)",
    "overlay": "0 12px 28px oklch(0% 0 0 / 0.16)"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "500ms",
    "easing": "cubic-bezier(0.25, 0.1, 0.25, 1)"
  }
}
